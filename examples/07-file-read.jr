// A whole file: write it, then read it back. `read_entire_file` is exported by `File` and allocates through
// the default context allocator; a program only replaces that allocator when it needs custom policy.
//
// Verified: `cargo run -q -p jr-cli -- run examples/07-file-read.jr -I modules`
// prints "hello from a Jairs program" and exits 0.
#import "Basic";
#import "File";
#import "String";

main :: () {
  path := "/tmp/jr-example-07.txt";

  if !write_entire_file(path, "hello from a Jairs program") {
    exit(1);
  }

  contents, ok := read_entire_file(path);
  if !ok {
    exit(2);
  }

  print("%\n", contents);
  free_string(contents);

  if !remove(path) {
    exit(3);
  }
}
