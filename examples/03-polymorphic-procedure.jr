// A polymorphic procedure. `$T` is inferred from the first call's argument, and the
// compiler generates one concrete procedure per distinct type actually used.
//
// Verified: `cargo run -q -p jr-cli -- run examples/03-polymorphic-procedure.jr -I modules`
// prints "7" then "floats too" and exits 0.
#import "Basic";

larger :: (a: $T, b: T) -> T {
    if a > b {
        return a;
    }
    return b;
}

main :: () {
    // Instantiates `larger` at s64.
    print_int(larger(3, 7));
    print_line("");

    // A second, distinct instantiation at float64 — the same declaration, a different
    // concrete procedure.
    if larger(1.5, 0.5) > 1.0 {
        print_line("floats too");
    }
}
