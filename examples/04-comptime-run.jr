// Compile-time execution with `#run`. `FIB_10` is computed once, while the compiler
// runs, by the same interpreter `jr run` also uses; the compiled binary carries only
// the resulting constant.
//
// Verified: `cargo run -q -p jr-cli -- run examples/04-comptime-run.jr -I modules`
// prints 55 and exits 0.
#import "Basic";

fibonacci :: (n: s64) -> s64 {
    if n < 2 {
        return n;
    }
    a := 0;
    b := 1;
    i := 1;
    while i < n {
        c := a + b;
        a = b;
        b = c;
        i = i + 1;
    }
    return b;
}

FIB_10 :: #run fibonacci(10);

main :: () {
    print_int(FIB_10);
    print_line("");
}
