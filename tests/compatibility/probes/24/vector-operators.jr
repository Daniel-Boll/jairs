#import "Basic";
#import "Math";

main :: () {
    a := vec3(1.0, 2.0, 3.0);
    b := vec3(3.0, 4.0, 2.5);

    if !(a + b == vec3(4.0, 6.0, 5.5)) {
        exit(1);
    }
    if !(b - a == vec3(2.0, 2.0, -0.5)) {
        exit(2);
    }
    if !(a * 3.0 == vec3(3.0, 6.0, 9.0)) {
        exit(3);
    }
    if !(3.0 * a == vec3(3.0, 6.0, 9.0)) {
        exit(4);
    }
    exit(0);
}
