#import "Basic";
Thread :: #import "Thread";

bump :: (argument: *u8) -> *u8 #c_call {
    counter := typed(s64, argument);
    i := 0;
    while i < 1000 {
        _ = atomic_add(counter, 1);
        i = i + 1;
    }
    return null;
}

main :: () {
    counter := 0;

    first, first_ok := Thread.spawn(bump, untyped(*counter));
    if !first_ok {
        exit(90);
    }
    second, second_ok := Thread.spawn(bump, untyped(*counter));
    if !second_ok {
        exit(91);
    }
    third, third_ok := Thread.spawn(bump, untyped(*counter));
    if !third_ok {
        exit(92);
    }

    if !Thread.join(*first) {
        exit(93);
    }
    if !Thread.join(*second) {
        exit(94);
    }
    if !Thread.join(*third) {
        exit(95);
    }

    print("counter=%\n", counter);
    if counter != 3000 {
        exit(1);
    }
    exit(0);
}
