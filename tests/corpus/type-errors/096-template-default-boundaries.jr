// EXPECT: E0252 E0252 — defaults still cannot infer a template's `$T` (ADR-0241)
//
// Compile-time value templates now use declaration-ordered argument slots, so
// fixed-type and `$N` literal defaults below are legal. A default still cannot
// infer `T`.

/// The default's own type contains `T`, so omitting it would have to invent
/// the type-variable binding from the default.
bad_type_default :: (value: $T = 3) -> T {
  return value;
}

/// A bare `T` later in the same signature is the same variable dependency.
bad_type_use_default :: (seed: $T, value: T = 3) -> T {
  return value;
}

/// A fixed ordinary parameter on a `$N` template may be omitted.
good_comptime_default :: ($N: s64, scale: s64 = 2) -> s64 {
  return N * scale;
}

/// Mixed `$T` + `$N` procedures use the same declaration-ordered binder.
good_mixed_default :: (value: $T, $N: s64 = 3, label := "item") -> T {
  return value;
}
