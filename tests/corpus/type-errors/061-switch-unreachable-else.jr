// EXPECT: E0260 — an `else` on a `switch` that already handles every member (ADR-0067 §4)
//
// Unreachable, and this is the diagnostic that makes E0258 worth having: without it, every `switch`
// could end in `else` and the exhaustiveness check would never fire. So an `else` is the way to make a
// *partial* match total, not a habit to add to a complete one.
Colour :: enum {
    RED;
    GREEN;
    BLUE;
}

pick :: (c: Colour) -> s64 {
    r := 0;
    switch c {
        case .RED;
            r = 1;
        case .GREEN;
            r = 2;
        case .BLUE;
            r = 4;
        else;
            r = 8;
    }
    return r;
}
