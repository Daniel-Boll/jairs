// EXPECT: E0233 — a declaration-time array length that calls a procedure (ADR-0245 §2)
//
// Local integer expression graphs now run through MIR and the compile-time VM before final
// signatures. Arithmetic, aliases, and chains of local file constants therefore work.
//
// Calls are the remaining boundary in this sub-wave: the expression thunk is compiled, but the
// provisional program does not yet carry procedure routines. The follow-up extends the same evaluator
// rather than adding a second folder.
four :: () -> s64 {
  return 4;
}

main :: () {
  // E0233: callable declaration expressions arrive in the procedure-routine follow-up.
  a: [four()]u8;
}
