// EXPECT: E0238 — a name that is not a member of the enum (ADR-0041)
// The suggestion comes from the enum's own member list, which only `jr-sema` knows
// (ADR-0031 §1) — so `jr check` explains its own error rather than leaving it to an editor.
Colour :: enum {
    RED;
    GREEN;
}

main :: () {
    c := Colour.REDD;
}
