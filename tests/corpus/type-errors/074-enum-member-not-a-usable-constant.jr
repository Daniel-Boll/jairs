// EXPECT: E0237 — a named enum value whose initializer needs a procedure routine (ADR-0245 §2)
//
// Alias chains are legal now. This pins the named-value diagnostic branch at the real remaining
// boundary: a local constant exists and has integer type, but its initializer calls a procedure the
// declaration-time program cannot load until the callable follow-up.
four :: () -> s64 {
  return 4;
}

COMPUTED :: four();

E :: enum {
  BAD :: COMPUTED;
}

main :: () {
}
