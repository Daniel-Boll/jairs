// EXPECT: E0246 — the bitwise operators are reserved for `enum_flags` (ADR-0048 §2)
// ADR-0043's whole design is that `&` on a flags type yields the flags type. Letting a user
// redefine `&` would put a second meaning on the operators that carry the flags semantics.
Vec2 :: struct {
    x: s64;
}

operator & :: (a: Vec2, b: Vec2) -> s64 {
    return a.x;
}

main :: () {
}
