// EXPECT: E0223 E0223 — pointer difference needs one non-zero-sized pointee type (ADR-0237)

Empty :: struct {
}

main :: () {
  a: [4]s64;
  p := *a[0];

  bytes := untyped(p);

  // Equal-sized or related representations do not matter: one operation needs one pointer type.
  mixed := p - bytes;

  // Every offset of a zero-sized pointee has the same address, so no element count can be recovered.
  left: Empty;
  right: Empty;

  zero := *left - *right;

  a[0] = mixed + zero;
}
