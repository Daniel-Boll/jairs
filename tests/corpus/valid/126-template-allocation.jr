// ADR-0155 §4-§5: a template that allocates its own scratch, and a template that calls another.
//
// Two compiler gaps this wave closed, isolated from the sort that found them. `125-stable-sort.jr` needs
// both at once and so cannot say which is which; this file exercises each on its own, so a regression names
// the one that broke.
//
//   scale        `typed(T, talloc(n * size_of(T)))` inside a `$T` body — the template allocates
//   total        `scale` calls `sum`, another template, with `T` already bound — template to template
//
// Both were refused before: `typed(T, ...)` was E0261 "needs a type" while `size_of(T)` beside it was fine,
// and a template calling a template was E0268 "cannot infer every $T" even though every variable was bound.
// Closing the first also needed the instantiation's pointer view threaded into MIR, or the clone lowered to
// nothing and the call reported `no routine for file N proc M` when it was reached.
//
// 2 + 4 + 6 = 12 doubled is 24, and the checksum adds 1 for the sum of the input (2+4+6 = 12): 36.
#import "Basic";

/// Sums a view. A template, and the *callee* of the template below.
sum :: (xs: []$T) -> s64 {
    total := 0;
    i := 0;
    while i < xs.count {
        total = total + xs[i];
        i = i + 1;
    }
    return total;
}

/// Doubles every element through a scratch buffer it allocates itself, then returns the doubled sum plus
/// the original — so the answer depends on both the allocation and the nested template call.
scale :: (xs: []$T) -> s64 {
    // The original, through another template. `T` is bound here, so nothing needs inferring from scratch —
    // which is exactly what the old refusal could not see.
    original := sum(xs);

    // The template allocates. `size_of(T)` was already legal; `typed(T, …)` beside it was not.
    scratch := typed(T, talloc(xs.count * size_of(T)));
    if scratch == null {
        return original;
    }
    buffer := view(scratch, xs.count);

    i := 0;
    while i < xs.count {
        buffer[i] = xs[i] * 2;
        i = i + 1;
    }
    // Read back through the view, so the scratch is genuinely written and read rather than merely allocated.
    return sum(buffer) + original;
}

main :: () {
    xs: [3]s64;
    xs[0] = 2;
    xs[1] = 4;
    xs[2] = 6;
    exit(scale(view(*xs[0], 3)));
}
