// **Integer formatting, executed.** The filename stays stable because ADR-0125 links to it, but the
// program now exercises the canonical `print` API. The differential harness compares stdout, so a
// wrong digit, order or sign fails independently of the checksum exit status.
#import "Basic";

main :: () {
  print("%\n", 0);
  print("%\n", 7);
  print("%\n", 42);
  print("%\n", 1234567890);
  print("%\n", -7);
  print("%\n", -1234567890);
  print("%\n", 9223372036854775807);

  // `print_error` writes to STDERR, which the harness compares separately — so a swapped file
  // descriptor is caught rather than washing out into stdout.
  print_error("to stderr\n");

  // A checksum of the values above, so a wrong digit changes the exit code as well as the output.
  // 7 + 42 - 7 = 42.
  exit(7 + 42 - 7);
}
