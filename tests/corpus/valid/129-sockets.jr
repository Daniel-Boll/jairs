// ADR-0158: the Socket module — a TCP client and server, in one process.
//
// PLAN §8.3 item 7, and the last of W7's nine modules. It is a corpus program — unlike `Process`, whose test
// is a `jr-cli` integration test because `execvp`'s array-of-pointers cannot survive the VM's one-level
// pointer translation (ADR-0158 §3). A `sockaddr_in` holds only integers, so passing it by pointer works in
// every engine, which is the difference and is worth having a test say out loud.
//
// **This program talks to itself over the loopback interface.** That is unusual for a corpus file and it is
// the point: a socket module whose test never opened a connection would be checking its byte-order
// arithmetic. It binds **port 0**, so the OS picks a free port and nothing collides with another test or
// another machine — which is exactly what `local_port` exists for, and hard-coding a number here would make
// the suite fail on a busy host.
//
// Fifteen independent bits:
//
//   1      the Jairs struct is the 16 bytes C's `sockaddr_in` is
//   2      `parse_ipv4("127.0.0.1")` is the loopback constant — so the octet order is right
//   4      four refusals: too few octets, an octet over 255, trailing content, empty
//   8      the port byte swap round-trips
//   16     `SO_REUSEADDR` is accepted
//   32     bind and listen on port 0
//   64     the OS chose a real port, readable back
//   128    a client connects to it
//   256    the client sends
//   512    the server receives exactly what was sent
//   1024   ...and the bytes are the right bytes
//   2048   the server answers
//   4096   `SHUT_WRITE` succeeds
//   8192   the client receives the answer
//   16384  and then sees zero, which is the peer's end-of-stream rather than an error
//
// All fifteen is 32767, and the exit status is that modulo 251 — 32767 = 130 * 251 + 137, so **137**.
//
// Client and server are the same process, in this order: listen, connect, accept. That works without
// concurrency because `connect` to a listening socket completes into the kernel's backlog before anyone
// calls `accept` — which is why `listen_on` takes a backlog and why it is 4 rather than 1.
#import "Basic";
#import "Socket";

main :: () {
    total := 0;

    // The C contract is "16 bytes". A Jairs struct whose layout drifted from that would be a wrong answer at
    // run time rather than a compile error, so the size is checked rather than assumed — through the module's
    // own routine, because `size_of` of an *imported* type is not available in every context that reads this
    // file (the `jr-sema` corpus harness resolves it with no module paths).
    if layout_is_c_compatible() {
        total = total + 1;
    }

    // Network order is big-endian, so `127.0.0.1` is `7f 00 00 01` — which as a little-endian `u32` is
    // `0x0100007f`. Getting the direction wrong produces a valid-looking address that reaches the wrong host,
    // and a symmetric test address would not catch it; this one is deliberately asymmetric.
    loopback, loopback_ok := parse_ipv4("127.0.0.1");
    if loopback_ok {
        if loopback == cast(u32, LOOPBACK_ADDRESS) {
            total = total + 2;
        }
    }

    // What must be refused. `inet_aton` accepts the first two of these as a documented historical quirk,
    // which is why this module parses addresses itself.
    _, few := parse_ipv4("1.2.3");
    _, big := parse_ipv4("1.2.3.256");
    _, trailing := parse_ipv4("1.2.3.4x");
    _, nothing := parse_ipv4("");
    if !few {
        if !big {
            if !trailing {
                if !nothing {
                    total = total + 4;
                }
            }
        }
    }

    if from_network_port(to_network_port(8080)) == 8080 {
        total = total + 8;
    }

    server, server_ok := make();
    if !server_ok {
        exit(1);
    }
    if set_reuse_address(*server) {
        total = total + 16;
    }
    if listen_on(*server, cast(u32, ANY_ADDRESS), 0, 4) {
        total = total + 32;
    }
    port, port_ok := local_port(*server);
    if port_ok {
        if port > 0 {
            total = total + 64;
        }
    }

    client, client_ok := make();
    if !client_ok {
        exit(2);
    }
    if connect_to(*client, cast(u32, LOOPBACK_ADDRESS), port) {
        total = total + 128;
    }

    peer, peer_ok := accept_one(*server);
    if peer_ok {
        if send_string(*client, "ping") {
            total = total + 256;
        }
        buffer: [16]u8;
        got, got_ok := receive(*peer, view(*buffer[0], 16));
        if got_ok {
            if got == 4 {
                total = total + 512;
            }
        }
        // `p` is 112. Checking a byte as well as the count is what distinguishes "four bytes arrived" from
        // "the four bytes that were sent arrived".
        if cast(s64, buffer[0]) == 112 {
            total = total + 1024;
        }

        if send_string(*peer, "pong!") {
            total = total + 2048;
        }
        // Half-closing the server's send side is what gives the client a clean end-of-stream after the
        // answer, rather than leaving it blocked on a `receive` that never returns.
        if shutdown_socket(*peer, SHUT_WRITE) {
            total = total + 4096;
        }
        answer, answer_ok := receive(*client, view(*buffer[0], 16));
        if answer_ok {
            if answer == 5 {
                total = total + 8192;
            }
        }
        // Zero is the peer closing, and it is a **success**. A caller who treated it as failure would loop
        // forever on a healthy connection, which is why `receive`'s contract says so.
        ended, ended_ok := receive(*client, view(*buffer[0], 16));
        if ended_ok {
            if ended == 0 {
                total = total + 16384;
            }
        }
        _ = close_socket(*peer);
    }

    _ = close_socket(*client);
    _ = close_socket(*server);
    print_int(total);
    exit(total % 251);
}
