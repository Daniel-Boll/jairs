sum_to :: (n: s64) -> s64 {
    total := 0;
    i := 1;
    while i <= n {
        total = total + i;
        i = i + 1;
    }
    return total;
}

with_break :: () -> s64 {
    i := 0;
    while true {
        i = i + 1;
        if i == 10 {
            break;
        }
        if i == 3 {
            continue;
        }
    }
    return i;
}
