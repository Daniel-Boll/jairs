// ADR-0223: `todo;` is terminal on its path, including in a valued procedure and in comptime code.

unfinished :: () -> s64 {
  todo;
}

pick :: (take_unfinished: bool) -> s64 {
  if take_unfinished {
    todo;
  }
  return 42;
}

comptime_pick :: () -> s64 {
  if false {
    todo;
  }
  return 7;
}

COMPTIME_PICK :: #run comptime_pick();

main :: () -> s64 {
  if COMPTIME_PICK != 7 {
    return 1;
  }
  if pick(false) != 42 {
    return 2;
  }
  return 0;
}
