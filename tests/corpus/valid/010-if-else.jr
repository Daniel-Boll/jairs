classify :: (n: s64) -> s64 {
    // Braces are required; a parenthesised condition is not.
    if n < 0 {
        return 0 - 1;
    } else if n == 0 {
        return 0;
    } else {
        return 1;
    }
}

single_statement :: (n: s64) -> s64 {
    // A single statement may follow the condition without braces.
    if n > 0  return n;
    return 0;
}
