// All arithmetic in Jairs traps on overflow (ADR-0002). There is no
// silent wraparound and no undefined behaviour.
main :: () {
    a := 6;
    b := 7;

    sum := a + b;
    diff := a - b;
    prod := a * b;
    quot := a / b;
    rem := a % b;

    // Unary negation.
    neg := -a;

    // Precedence: `*` binds tighter than `+`.
    mixed := a + b * 2;

    // Parentheses override precedence.
    grouped := (a + b) * 2;
}
