// Named and default arguments (ADR-0053) — the last W2 feature besides `#scope_*`.
//
// A named argument matches a *parameter name*, which `Item::ProcType` does not carry: it holds types
// only, and two procedures with identical types genuinely have different parameter names. So the
// names live on `ProcSig`, the per-**procedure** record, and sema rewrites the argument list into
// positional order before anything else sees it. `jr-mir` reads that order and never learns what a
// name is — the same split ADR-0048 §5 made for overload resolution, for the same reason: two passes
// deciding one thing are two chances to disagree.
//
// A default must be a **literal** (ADR-0053 §2), and that is a layering constraint rather than a
// preference: const-eval runs downstream of signature resolution (ADR-0018 §3), so a default that
// could be `SIZE` would make a signature depend on a constant whose own type depends on signatures.
// ADR-0039 §3a records the identical ordering for an array length.
//
// Four things here are worth checking rather than assuming:
//
//   * **reordering actually reorders.** Every procedure below encodes its arguments positionally into
//     one number — `x * 1000 + y * 100 + …` — so passing them to the wrong parameters is a *different
//     answer* rather than a plausible one. Testing with all-equal arguments would prove nothing;
//   * a **default is filled in at the call site**, so a call omitting an argument must produce the
//     declared value rather than zero. `Rvalue::Call`'s operand list is one short without it, which
//     MIR would refuse — so this is a refusal-versus-value check, not a crash check;
//   * a default **need not be trailing** (ADR-0053 §2). `only_named` below has one first, which is
//     callable only by name, and that is deliberate rather than an oversight;
//   * the **common path is untouched**: a call with no names and no defaults gets no entry in the
//     filled-argument map at all, so `add(1, 2)` lowers exactly as it did before this wave.
//
// The refusals live in `imports/invalid/008-named-argument-rules.jr`, because a file that must check
// cleanly cannot hold one.
//
// The `exit` at the end is what gives this file teeth under the differential harness: only two
// corpus programs print, so a computation has to be made observable through an exit status or the
// comparison is silence against silence.
#import "Basic";

/// Two defaults, so a call may omit one or both. The encoding makes each parameter's position
/// observable in the result.
draw :: (x: s64, y: s64, colour: s64 = 7, scale: s64 = 1) -> s64 {
    return x * 1000 + y * 100 + colour * 10 + scale;
}

/// A default that is **not** trailing (ADR-0053 §2). The only way to call this is `only_named(b = …)`,
/// which is a legal signature meaning something perfectly clear — requiring defaults last would be a
/// simpler rule that forbids it for nothing.
only_named :: (a: s64 = 5, b: s64) -> s64 {
    return a * 10 + b;
}

/// Defaults of every literal kind ADR-0053 §2 admits, so the interning path is exercised for each
/// rather than only for integers.
kinds :: (flag: bool = true, ratio: float64 = 0.5, small: u8 = 9) -> s64 {
    n := 0;
    if flag {
        n = n + 1;
    }
    if ratio == 0.5 {
        n = n + 2;
    }
    if small == 9 {
        n = n + 4;
    }
    return n;
}

/// **No names and no defaults**, so this call gets no filled-argument entry and lowers exactly as it
/// did before this wave. Here to prove the common path is untouched rather than merely believed to be.
add :: (a: s64, b: s64) -> s64 {
    return a + b;
}

/// A negative default, because ADR-0038's range check is against the type's *range* rather than its
/// maximum magnitude — so `s8`'s minimum is representable and a magnitude-based check would refuse it.
edge :: (n: s8 = -128) -> s64 {
    if n == -128 {
        return 1;
    }
    return 0;
}

main :: () {
    n := 0;

    // ---- defaults, omitted and supplied ---------------------------------------------------

    // Both defaults apply: colour 7, scale 1.
    if draw(1, 2) == 1271 {
        n = n + 1;
    }
    // One supplied positionally, one defaulted.
    if draw(1, 2, 3) == 1231 {
        n = n + 2;
    }
    // Both supplied positionally, so no default is used.
    if draw(1, 2, 3, 4) == 1234 {
        n = n + 4;
    }

    // ---- named arguments ------------------------------------------------------------------

    // A named argument skipping over a defaulted one: colour stays 7.
    if draw(1, 2, scale = 9) == 1279 {
        n = n + 8;
    }
    // Every argument named, in declaration order.
    if draw(x = 1, y = 2) == 1271 {
        n = n + 16;
    }
    // **Named out of order**, which is the case that proves reordering happens: a pass that ignored
    // names would compute 2100 + 1 * 100 here rather than 1271.
    if draw(y = 2, x = 1) == 1271 {
        n = n + 32;
    }
    // Positional first, then named — §3's rule, in the direction that is allowed.
    if draw(1, y = 2, colour = 3) == 1231 {
        n = n + 64;
    }
    // All four named, fully reversed.
    if draw(scale = 4, colour = 3, y = 2, x = 1) == 1234 {
        n = n + 128;
    }

    // ---- a non-trailing default ------------------------------------------------------------

    if only_named(b = 3) == 53 {
        n = n + 256;
    }
    if only_named(a = 1, b = 3) == 13 {
        n = n + 512;
    }

    // ---- every literal kind of default -----------------------------------------------------

    if kinds() == 7 {
        n = n + 1024;
    }
    // One overridden, the rest defaulted.
    if kinds(flag = false) == 6 {
        n = n + 2048;
    }

    // ---- the untouched common path ---------------------------------------------------------

    if add(3, 4) == 7 {
        n = n + 4096;
    }

    // ---- a negative default ----------------------------------------------------------------

    if edge() == 1 {
        n = n + 8192;
    }

    // Every assertion: 16383.
    if n == 16383 {
        exit(0);
    }
    exit(1);
}
