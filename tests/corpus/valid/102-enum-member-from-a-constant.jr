// An enum member's value that **names a constant** (ADR-0129) — the same trick ADR-0070 gave an array
// length, generalised to the other place a literal was demanded.
//
// The asymmetry this closes was recorded by ADR-0127 §3 as a promise a completed wave had not kept, and
// E0237's own note admitted it: an array length had learnt to read a named constant and an enum member
// had not, "a generalisation owed rather than a limit of the evaluator". Nothing about the evaluator
// needed to change — for `NOT_FOUND :: 404` there is nothing to evaluate, and `jr-sema` already resolves
// names against the file scope. It still depends on neither `jr-db` nor `jr-vm`.
//
// Five things here are worth checking rather than assuming, and the `exit` gives each teeth:
//
//   * a member whose value **names a constant** is that constant's value;
//   * **auto-numbering continues from it** — `NEXT` is 405, not 2. This is the subtle one: ADR-0041 §3
//     makes each member one past the *previous value* rather than its own index, so a named value that
//     did not feed `next` would leave later members silently wrong rather than rejected;
//   * a **negative** constant works, where an array length rejects one — the shared helper answers the
//     raw `i128` and each caller applies its own range, so `s64`'s sign survives (ADR-0129 §2);
//   * a **flags** enum takes one too, and the next flag is the power of two above it (ADR-0043 §2);
//   * the **same constant** names an array length *and* an enum member in one file, which is the
//     evidence that one definition of "readable constant" now serves both callers rather than two.
//
// What is **not** here is a value needing evaluation, or a member naming a **sibling** member — both
// still E0237 (`type-errors/074`), for the reasons ADR-0129 §4 gives.
#import "Basic";

/// The constant, shared by an enum member and an array length below. One place to change a number that
/// two different kinds of declaration agree on.
NOT_FOUND :: 404;

/// Negative, to prove the sign survives a path an array length uses to reject exactly this value.
NEG_ONE :: -1;

/// The third flag, named rather than written, so the flags enum's doubling is driven by a constant.
FLAG_C :: 4;

/// Used as **both** an enum member's value and an array length, which is the point: one definition of
/// "a constant whose initialiser is a literal" now answers for both.
THREE :: 3;

Status :: enum {
    OK :: 200;
    MISSING :: NOT_FOUND;
    /// No explicit value: ADR-0041 §3 makes this **one past `MISSING`**, so it is 405. A named value
    /// that did not feed the auto-numbering would make this 2 and nothing would complain.
    NEXT;
    BAD :: NEG_ONE;
    /// The same constant that gives an array length below, so the two callers meet in one file.
    TRIPLE :: THREE;
}

Perm :: enum_flags {
    READ;
    WRITE;
    EXEC :: FLAG_C;
    /// One past a power of two doubles, so a named flag still drives the sequence (ADR-0043 §2).
    SPECIAL;
}

main :: () {
    n := 0;

    // The member is the constant's value.
    if cast(s64, Status.MISSING) == 404 {
        n = n + 1;
    }

    // An explicit literal member is unaffected by the new path.
    if cast(s64, Status.OK) == 200 {
        n = n + 2;
    }

    // **Auto-numbering continued from the named value.** 405, not 2.
    if cast(s64, Status.NEXT) == 405 {
        n = n + 4;
    }

    // A negative named constant keeps its sign.
    if cast(s64, Status.BAD) == -1 {
        n = n + 8;
    }

    // The flags enum: named member, then the power of two above it.
    if cast(s64, Perm.EXEC) == 4 {
        n = n + 16;
    }
    if cast(s64, Perm.SPECIAL) == 8 {
        n = n + 32;
    }

    // The same constant as an **array length** and as a member value, so one file exercises both
    // callers of the shared helper. A regression that broke either would change this arithmetic.
    small: [THREE]s64;
    if small.count == 3 && cast(s64, Status.TRIPLE) == 3 {
        n = n + 64;
    }

    // Every assertion: 127.
    if n == 127 {
        exit(0);
    }
    exit(1);
}
