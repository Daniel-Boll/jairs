// A module whose procedures have defaulted parameters, for `imports/valid/020` (ADR-0188 §2).
//
// Deliberately trivial arithmetic: the file is about the *call* mechanics across a boundary, and any
// interesting body would make a failure ambiguous between the default and the computation.

/// Adds two numbers; `b` defaults to 3.
add :: (a: s64, b: s64 = 3) -> s64 {
  return a + b;
}

/// Adds three numbers; `c` defaults to 100, `b` does not default.
///
/// The asymmetry is the point: a fill that is off by one would satisfy `add` and get this wrong.
three :: (a: s64, b: s64, c: s64 = 100) -> s64 {
  return a + b + c;
}

/// The ADR-0235 spelling, so imports/valid/020 proves inferred defaults cross
/// the same module boundary as explicitly typed defaults.
inferred :: (a := 4, b := 6) -> s64 {
  return a * 10 + b;
}

/// Returns the type-polymorphic value. The fixed default exists to prove that
/// reversed imported names bind by declaration position (ADR-0236).
template_identity :: (value: $T, scale: s64 = 2) -> T {
  return value;
}

/// A fixed explicitly typed default on a pure `$T` procedure.
template_typed :: (value: $T, scale: s64 = 3) -> s64 {
  return scale;
}

/// A fixed inferred default on a pure `$T` procedure.
template_inferred :: (value: $T, amount := 5) -> s64 {
  return amount;
}
