{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "jairs",
  "scopeName": "source.jairs",
  "aliases": ["jr", "jai"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#directives" },
    { "include": "#notes" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#declaration" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#polymorph" },
    { "include": "#operators" },
    { "include": "#call" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.jairs",
          "match": "///.*$"
        },
        {
          "name": "comment.line.documentation.module.jairs",
          "match": "//!.*$"
        },
        {
          "name": "comment.line.double-slash.jairs",
          "match": "//.*$"
        },
        {
          "name": "comment.block.jairs",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [{ "include": "#comments" }]
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "keyword.control.directive.jairs",
          "match": "#(import|foreign|system_library|run|insert|code|expand|modify|bake_arguments|scope_module|scope_export|scope_file|no_abc|c_call|must|align|place|soa)\\b"
        },
        {
          "name": "keyword.control.directive.unknown.jairs",
          "match": "#[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "notes": {
      "name": "entity.other.attribute-name.jairs",
      "match": "@[A-Za-z_][A-Za-z0-9_]*"
    },
    "strings": {
      "name": "string.quoted.double.jairs",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.jairs",
          "match": "\\\\(n|r|t|0|\\\\|\"|u[0-9A-Fa-f]{4})"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.jairs",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][-+]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.float.jairs",
          "match": "\\b[0-9][0-9_]*[eE][-+]?[0-9]+\\b"
        },
        {
          "name": "constant.numeric.hex.jairs",
          "match": "\\b0x[0-9A-Fa-f_]+\\b"
        },
        {
          "name": "constant.numeric.binary.jairs",
          "match": "\\b0b[01_]+\\b"
        },
        {
          "name": "constant.numeric.octal.jairs",
          "match": "\\b0o[0-7_]+\\b"
        },
        {
          "name": "constant.numeric.integer.jairs",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "declaration": {
      "patterns": [
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(::)\\s*(struct|union|variant|enum_flags|enum)\\b",
          "captures": {
            "1": { "name": "entity.name.type.jairs" },
            "2": { "name": "keyword.operator.constant.jairs" },
            "3": { "name": "storage.type.jairs" }
          }
        },
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(::)(?=\\s*\\()",
          "captures": {
            "1": { "name": "entity.name.function.jairs" },
            "2": { "name": "keyword.operator.constant.jairs" }
          }
        },
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(::)",
          "captures": {
            "1": { "name": "variable.other.constant.jairs" },
            "2": { "name": "keyword.operator.constant.jairs" }
          }
        },
        {
          "match": "(:=)",
          "name": "keyword.operator.declaration.jairs"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.jairs",
          "match": "\\b(if|else|while|for|return|break|continue|defer|switch|case|push_context)\\b"
        },
        {
          "name": "keyword.operator.word.jairs",
          "match": "\\b(cast|xx|using|operator)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.jairs",
          "match": "\\b(s8|s16|s32|s64|u8|u16|u32|u64|bool|string|float32|float64|void|Type|Any|Type_Info|Type_Info_Kind|Context)\\b"
        }
      ]
    },
    "constants": {
      "name": "constant.language.jairs",
      "match": "\\b(true|false|null|context)\\b"
    },
    "polymorph": {
      "name": "entity.name.type.parameter.jairs",
      "match": "\\$[A-Za-z_][A-Za-z0-9_]*"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.jairs",
          "match": "->"
        },
        {
          "name": "keyword.operator.wrapping.jairs",
          "match": "(\\+%|-%|\\*%)=?"
        },
        {
          "name": "keyword.operator.assignment.compound.jairs",
          "match": "(\\+|-|\\*|/|%|&|\\||\\^|<<|>>)="
        },
        {
          "name": "keyword.operator.comparison.jairs",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.jairs",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.bitwise.jairs",
          "match": "(<<|>>|&|\\||\\^|~)"
        },
        {
          "name": "keyword.operator.deref.jairs",
          "match": "\\.\\*"
        },
        {
          "name": "keyword.operator.arithmetic.jairs",
          "match": "(\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.uninitialised.jairs",
          "match": "---"
        },
        {
          "name": "keyword.operator.assignment.jairs",
          "match": "="
        }
      ]
    },
    "call": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "entity.name.function.call.jairs" }
      }
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.terminator.jairs", "match": ";" },
        { "name": "punctuation.separator.jairs", "match": "[,:]" }
      ]
    }
  }
}
