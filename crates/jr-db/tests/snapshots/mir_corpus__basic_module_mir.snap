    store s1 <- {2_s64, 2_Type_Info_Kind, "s64", 8_s64, 8_s64, 0_s64, 0_s64, static[0], true, static[0], 0_s64}
    v3: *Type_Info = addr s1
    zero s2
    store s2.0 <- v3
    store s2.1 <- v2
    v4: Any = load s2
    zero s3
    store s3[0_s64] <- v4
    v5: *Any = addr s3[0_s64]
    zero s4
    store s4.view_data <- v5
    store s4.view_count <- 1_s64
    v6: []Any = load s4
    discard call proc23(v0, "%", v6)
    return
}
