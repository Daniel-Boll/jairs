proc print_digits -> void {
  params: v0: *Context, v1: s64
  bb0(v0: *Context, v1: s64):
    v2: bool = v1 >= 10_s64
    branch v2 ? bb1() : bb2()
  bb1():
    v3: s64 = v1 / 10_s64
    discard call proc8(v0, v3)
    goto bb3()
  bb2():
    goto bb3()
  bb3():
    v4: s64 = v1 % 10_s64
    v5: s64 = v4 + 48_s64
    v6: u8 = convert v5 from s64
    discard call proc7(v0, v6)
    return
}
proc print_int -> void {
  params: v0: *Context, v1: s64
  bb0(v0: *Context, v1: s64):
    v2: bool = v1 < 0_s64
    branch v2 ? bb1() : bb2()
  bb1():
    discard call proc4(v0, "-")
    v3: s64 = -v1
    discard call proc8(v0, v3)
    goto bb3()
  bb2():
    discard call proc8(v0, v1)
    goto bb3()
  bb3():
    return
}
