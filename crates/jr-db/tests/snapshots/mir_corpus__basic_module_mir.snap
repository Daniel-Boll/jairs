  params: v0: *Context, v1: string
  slots:
    s0: string  // temporary
  bb0(v0: *Context, v1: string):
    store s0 <- v1
    v2: *u8 = load s0.data
    v3: s64 = load s0.count
    discard call proc0(1_s64, v2, v3)
    return
}
