//! The Math module: the exact closed-form functions **and** the libm transcendentals.
//!
//! Written in Jairs, with two halves that reach `float` correctness by different routes — and that split is the
//! interesting thing about the module.
//!
//! # The exact half, computed in Jairs
//!
//! `abs`, `min`, `max`, `sign`, `clamp`, `pow`, `gcd`, and `floor`/`ceil`/`round` are computed here, in Jairs,
//! **exactly** — so both engines produce identical bits. `floor` is closed-form (truncate toward zero with a
//! cast, adjust by sign), which is why it is on this side even though it is a "float function": the line is
//! **exactness**, not difficulty.
//!
//! # The transcendentals, as libm wraps (ADR-0115)
//!
//! `sqrt`, `sin`, `cos`, `exp`, `ln`, `powf` are **`#foreign` wraps of libm**, not Jairs approximations.
//! ADR-0112 shipped `Math` *without* them and said so plainly, because a float could not cross the FFI boundary
//! then and an approximation written in Jairs would be **wrong in a way this project cannot tolerate**: its last
//! bits depend on evaluation order, and the comptime VM and native Cranelift could round a fused multiply-add
//! differently, so the two engines would disagree on the last ulp — the one thing the differential harness
//! treats as a failure.
//!
//! ADR-0114 let a float cross the boundary, which is the sub-wave `Math` named as its unblocker. So the
//! transcendentals arrive the *right* way: libm is correctly rounded, and **both engines call the same libm**,
//! so `sqrt(2.0)` is bit-identical in the VM and native code. A library named the language feature it needed and
//! the language delivered it — the same shape as typed allocation unblocking `List`.

#import "Basic";

/// The square root of `x`. NaN for a negative `x`, as IEEE-754 defines.
sqrt :: (x: float64) -> float64 #foreign libc "sqrt";

/// The sine of `x` radians.
sin :: (x: float64) -> float64 #foreign libc "sin";

/// The cosine of `x` radians.
cos :: (x: float64) -> float64 #foreign libc "cos";

/// `e` raised to `x`.
exp :: (x: float64) -> float64 #foreign libc "exp";

/// The natural logarithm of `x`. NaN or -inf for `x <= 0`, as IEEE-754 defines.
///
/// Named `ln`, not `log`: C's `log` *is* the natural logarithm, but the name misleads a reader expecting base
/// 10. `ln` says which base without a comment, and a `log10` wrap is separate when a caller wants it.
ln :: (x: float64) -> float64 #foreign libc "log";

/// `base` raised to a real `exponent` — the floating-point counterpart of the integer `pow` below.
///
/// A different name from the integer `pow`, because they take different types and there is no overload
/// resolution that would pick between them (the reason `Sort` takes a comparison, ADR-0104 §3). `powf(2.0, 0.5)`
/// is a square root, which the integer `pow` cannot express.
powf :: (base: float64, exponent: float64) -> float64 #foreign libc "pow";

/// The absolute value of an `s64`.
///
/// `min_of_s64` (the most negative `s64`) has no positive counterpart, so `abs(min)` overflows — and this uses
/// the trapping subtraction (ADR-0002), so it **traps** rather than returning a negative "absolute value". That
/// is the honest answer: there is no correct result, and a silent wrong one is worse than a trap.
abs :: (x: s64) -> s64 {
    if x < 0 {
        return 0 - x;
    }
    return x;
}

/// The absolute value of a `float64`.
///
/// A separate procedure rather than a `$T` one, because `0 - x` means different things for the two types and
/// there is no overload resolution across a template's instantiated type yet (the reason `Sort` takes a
/// comparison, ADR-0104 §3). `abs(-0.0)` is `0.0`, which is what negating a negative zero gives.
fabs :: (x: float64) -> float64 {
    if x < 0.0 {
        return 0.0 - x;
    }
    return x;
}

/// The smaller of two `s64`s.
min :: (a: s64, b: s64) -> s64 {
    if a < b {
        return a;
    }
    return b;
}

/// The larger of two `s64`s.
max :: (a: s64, b: s64) -> s64 {
    if a > b {
        return a;
    }
    return b;
}

/// `value` confined to `[low, high]`.
///
/// `low` is applied after `high`, so a caller who passes `low > high` gets `low` — a defined answer for a
/// nonsensical range rather than an unspecified one. Naming which bound wins is better than leaving it to the
/// comparison order.
clamp :: (value: s64, low: s64, high: s64) -> s64 {
    result := value;
    if result > high {
        result = high;
    }
    if result < low {
        result = low;
    }
    return result;
}

/// -1, 0 or 1 as `x` is negative, zero or positive.
sign :: (x: s64) -> s64 {
    if x < 0 {
        return -1;
    }
    if x > 0 {
        return 1;
    }
    return 0;
}

/// `base` raised to a non-negative integer `exponent`, by repeated multiplication.
///
/// **Integer, and exact.** A negative exponent would give a fraction, which an `s64` cannot hold, so it is
/// refused by returning 0 — distinguishable from every real power except `0` itself, which a caller asking for
/// `pow(0, n)` already expects. Overflow traps through the multiplication (ADR-0002), which is the right answer
/// for a result that does not fit.
pow :: (base: s64, exponent: s64) -> s64 {
    if exponent < 0 {
        return 0;
    }
    result := 1;
    i := 0;
    while i < exponent {
        result = result * base;
        i = i + 1;
    }
    return result;
}

/// The greatest common divisor of two non-negative integers, by Euclid's algorithm.
///
/// `gcd(0, 0)` is 0, and `gcd(x, 0)` is `x` — the standard boundary. Negative inputs are taken by their absolute
/// value, so the result is always non-negative, which is the only sign a divisor sensibly has.
gcd :: (a: s64, b: s64) -> s64 {
    x := abs(a);
    y := abs(b);
    while y != 0 {
        t := y;
        y = x % y;
        x = t;
    }
    return x;
}

/// The largest whole `float64` not greater than `x`.
///
/// Closed-form and exact in both engines: cast toward zero, then step down by one when a negative `x` was cut
/// upward. `cast(s64, x)` truncates toward zero (ADR-0037), so for `-1.5` it gives `-1`, one *too high* — the
/// adjustment is what makes it a floor rather than a truncation.
///
/// Only meaningful for an `x` whose whole part fits an `s64`; a larger magnitude is already an exact integer as
/// a `float64`, so returning it unchanged is correct, which the range check below preserves.
floor :: (x: float64) -> float64 {
    truncated := cast(float64, cast(s64, x));
    if truncated > x {
        return truncated - 1.0;
    }
    return truncated;
}

/// The smallest whole `float64` not less than `x`.
///
/// The mirror of `floor`: truncation is one *too low* for a positive fraction, so step up when it undershoots.
ceil :: (x: float64) -> float64 {
    truncated := cast(float64, cast(s64, x));
    if truncated < x {
        return truncated + 1.0;
    }
    return truncated;
}

/// `x` rounded to the nearest whole `float64`, halves away from zero.
///
/// Away from zero rather than to-even, because it is the rule a reader expects from "round" and it is exact to
/// state: add half of the sign's magnitude and truncate. Banker's rounding is a defensible alternative and a
/// different decision; this one is the unsurprising one.
round :: (x: float64) -> float64 {
    if x < 0.0 {
        return cast(float64, cast(s64, x - 0.5));
    }
    return cast(float64, cast(s64, x + 0.5));
}

// ============================================================================
// Vectors (ADR-0130, sub-wave 3a)
// ============================================================================
//
// `Vector2`, `Vector3` and `Vector4`, with `+ - * / ==` as **operator overloads** and the rest as
// named procedures. ADR-0115 declared this module complete without them, which ADR-0127 §3 recorded as
// one of six promises a completed wave did not keep; this is that promise, in the part that needs no
// language change.
//
// # Why the element type is `float64`
//
// Jai's `Vector3` is `float32`, for SIMD packing and GPU interchange. Neither exists here yet — SIMD is
// W8 and graphics W10 — while `sqrt` is `#foreign libc "sqrt"`, which is a **double**. `length` therefore
// needs a `float64` at the boundary, so a `float32` vector would cast on the way in and back on the way
// out at every call. The element type follows the module it lives in rather than the language it is
// modelled on. A packed `float32` vector belongs with the wave that has a reason for it.
//
// # Why the names carry a dimension
//
// `dot3` rather than `dot`, because **Jairs has no procedure overloading**: a second `dot` is E0200,
// duplicate declaration. Only *operators* resolve by parameter type, which is why `+` needs no suffix and
// `dot` does. This is a language gap showing through a library's names, not a naming preference — when
// overloading arrives these collapse into one overloaded `dot`, and the operators will not change at all.
//
// # Why there are three types rather than one generic `Vector($T, $N)`
//
// Because a template body cannot use the operators it would need. Resolving `a + b` inside a `$T` body
// against the *instantiated* type is operator-bounded polymorphism, which `Sort` also names as absent
// (`modules/Sort` §18). A generic vector would have to spell out `a.x + b.x` per component anyway, and
// could not offer `+` to its callers, so it would be strictly worse than three concrete types.

/// A 2-component vector of `float64`.
Vector2 :: struct {
    /// The first component.
    x: float64;
    /// The second component.
    y: float64;
}

/// A 3-component vector of `float64`.
Vector3 :: struct {
    /// The first component.
    x: float64;
    /// The second component.
    y: float64;
    /// The third component.
    z: float64;
}

/// A 4-component vector of `float64`. The `w` component is what makes a `Matrix4` translation reachable.
Vector4 :: struct {
    /// The first component.
    x: float64;
    /// The second component.
    y: float64;
    /// The third component.
    z: float64;
    /// The fourth component.
    w: float64;
}

/// Builds a [`Vector2`].
vec2 :: (x: float64, y: float64) -> Vector2 {
    r: Vector2;
    r.x = x;
    r.y = y;
    return r;
}

/// Builds a [`Vector3`].
vec3 :: (x: float64, y: float64, z: float64) -> Vector3 {
    r: Vector3;
    r.x = x;
    r.y = y;
    r.z = z;
    return r;
}

/// Builds a [`Vector4`].
vec4 :: (x: float64, y: float64, z: float64, w: float64) -> Vector4 {
    r: Vector4;
    r.x = x;
    r.y = y;
    r.z = z;
    r.w = w;
    return r;
}

operator + :: (a: Vector2, b: Vector2) -> Vector2 {
    return vec2(a.x + b.x, a.y + b.y);
}

operator + :: (a: Vector3, b: Vector3) -> Vector3 {
    return vec3(a.x + b.x, a.y + b.y, a.z + b.z);
}

operator + :: (a: Vector4, b: Vector4) -> Vector4 {
    return vec4(a.x + b.x, a.y + b.y, a.z + b.z, a.w + b.w);
}

operator - :: (a: Vector2, b: Vector2) -> Vector2 {
    return vec2(a.x - b.x, a.y - b.y);
}

operator - :: (a: Vector3, b: Vector3) -> Vector3 {
    return vec3(a.x - b.x, a.y - b.y, a.z - b.z);
}

operator - :: (a: Vector4, b: Vector4) -> Vector4 {
    return vec4(a.x - b.x, a.y - b.y, a.z - b.z, a.w - b.w);
}

operator * :: (a: Vector2, s: float64) -> Vector2 {
    return vec2(a.x * s, a.y * s);
}

operator * :: (s: float64, a: Vector2) -> Vector2 {
    return vec2(a.x * s, a.y * s);
}

operator * :: (a: Vector3, s: float64) -> Vector3 {
    return vec3(a.x * s, a.y * s, a.z * s);
}

operator * :: (s: float64, a: Vector3) -> Vector3 {
    return vec3(a.x * s, a.y * s, a.z * s);
}

operator * :: (a: Vector4, s: float64) -> Vector4 {
    return vec4(a.x * s, a.y * s, a.z * s, a.w * s);
}

operator * :: (s: float64, a: Vector4) -> Vector4 {
    return vec4(a.x * s, a.y * s, a.z * s, a.w * s);
}

operator / :: (a: Vector2, s: float64) -> Vector2 {
    return vec2(a.x / s, a.y / s);
}

operator / :: (a: Vector3, s: float64) -> Vector3 {
    return vec3(a.x / s, a.y / s, a.z / s);
}

operator / :: (a: Vector4, s: float64) -> Vector4 {
    return vec4(a.x / s, a.y / s, a.z / s, a.w / s);
}

operator == :: (a: Vector2, b: Vector2) -> bool {
    return a.x == b.x && a.y == b.y;
}

operator == :: (a: Vector3, b: Vector3) -> bool {
    return a.x == b.x && a.y == b.y && a.z == b.z;
}

operator == :: (a: Vector4, b: Vector4) -> bool {
    return a.x == b.x && a.y == b.y && a.z == b.z && a.w == b.w;
}

/// Negates each component. A **procedure, not `operator -`**, because a unary overload would collide
/// with the binary one on arity alone and is out of scope (`type-errors/048`).
negate2 :: (a: Vector2) -> Vector2 {
    return vec2(-a.x, -a.y);
}

/// Negates each component. See [`negate2`] for why this is not `operator -`.
negate3 :: (a: Vector3) -> Vector3 {
    return vec3(-a.x, -a.y, -a.z);
}

/// Negates each component. See [`negate2`] for why this is not `operator -`.
negate4 :: (a: Vector4) -> Vector4 {
    return vec4(-a.x, -a.y, -a.z, -a.w);
}

/// The dot product.
dot2 :: (a: Vector2, b: Vector2) -> float64 {
    return a.x * b.x + a.y * b.y;
}

/// The dot product.
dot3 :: (a: Vector3, b: Vector3) -> float64 {
    return a.x * b.x + a.y * b.y + a.z * b.z;
}

/// The dot product.
dot4 :: (a: Vector4, b: Vector4) -> float64 {
    return a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w;
}

/// The **squared** length. Exact for exact components, since it takes no square root — prefer it when
/// comparing magnitudes, where the root is a cost with no effect on the ordering.
length_squared2 :: (a: Vector2) -> float64 {
    return dot2(a, a);
}

/// The squared length. See [`length_squared2`].
length_squared3 :: (a: Vector3) -> float64 {
    return dot3(a, a);
}

/// The squared length. See [`length_squared2`].
length_squared4 :: (a: Vector4) -> float64 {
    return dot4(a, a);
}

/// The length. Calls libm's `sqrt`, so both engines agree to the last bit (ADR-0115).
length2 :: (a: Vector2) -> float64 {
    return sqrt(length_squared2(a));
}

/// The length. See [`length2`].
length3 :: (a: Vector3) -> float64 {
    return sqrt(length_squared3(a));
}

/// The length. See [`length2`].
length4 :: (a: Vector4) -> float64 {
    return sqrt(length_squared4(a));
}

/// The distance between two points.
distance2 :: (a: Vector2, b: Vector2) -> float64 {
    return length2(a - b);
}

/// The distance between two points.
distance3 :: (a: Vector3, b: Vector3) -> float64 {
    return length3(a - b);
}

/// The distance between two points.
distance4 :: (a: Vector4, b: Vector4) -> float64 {
    return length4(a - b);
}

/// A unit vector in the same direction.
///
/// **A zero vector answers the zero vector**, rather than a NaN or a trap. There is no unit vector in
/// "no direction", so every implementation has to choose; returning zero keeps the result usable in the
/// arithmetic that follows, where a NaN would silently poison every later component and a trap would make
/// a degenerate case unsurvivable. A caller who needs to know tests [`length_squared2`] first.
normalize2 :: (a: Vector2) -> Vector2 {
    len := length2(a);
    if len == 0.0 {
        return vec2(0.0, 0.0);
    }
    return a / len;
}

/// A unit vector in the same direction. See [`normalize2`] for the zero case.
normalize3 :: (a: Vector3) -> Vector3 {
    len := length3(a);
    if len == 0.0 {
        return vec3(0.0, 0.0, 0.0);
    }
    return a / len;
}

/// A unit vector in the same direction. See [`normalize2`] for the zero case.
normalize4 :: (a: Vector4) -> Vector4 {
    len := length4(a);
    if len == 0.0 {
        return vec4(0.0, 0.0, 0.0, 0.0);
    }
    return a / len;
}

/// The cross product — **`Vector3` only**, because the cross product is only a binary operation in three
/// dimensions. There is deliberately no `cross2` or `cross4`.
cross :: (a: Vector3, b: Vector3) -> Vector3 {
    return vec3(a.y * b.z - a.z * b.y, a.z * b.x - a.x * b.z, a.x * b.y - a.y * b.x);
}

/// Linear interpolation: `t = 0.0` gives `a`, `t = 1.0` gives `b`. `t` outside that range extrapolates,
/// which is deliberate — clamping would hide a caller's mistake and [`clamp`] is one call away.
lerp2 :: (a: Vector2, b: Vector2, t: float64) -> Vector2 {
    return a + (b - a) * t;
}

/// Linear interpolation. See [`lerp2`].
lerp3 :: (a: Vector3, b: Vector3, t: float64) -> Vector3 {
    return a + (b - a) * t;
}

/// Linear interpolation. See [`lerp2`].
lerp4 :: (a: Vector4, b: Vector4, t: float64) -> Vector4 {
    return a + (b - a) * t;
}
