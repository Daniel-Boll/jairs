/target
**/*.rs.bk
*.pdb

# insta pending snapshots
**/*.snap.new
**/*.pending-snap

# Compiled Jairs output
/examples/**/*.o
/examples/**/*.dSYM
/tests/**/*.o
/out
/*.o

# tree-sitter generated artefacts.
#
# ALL generated output is ignored and regenerated by `tree-sitter generate`
# (the corpus-drift CI job does this). Only hand-written sources are tracked:
# grammar.js, queries/*.scm, test/corpus/*, and src/scanner.c — the scanner is
# hand-written because nested block comments cannot be expressed as a token
# regex, so it must NOT be ignored here.
/tree-sitter-jairs/src/parser.c
/tree-sitter-jairs/src/grammar.json
/tree-sitter-jairs/src/node-types.json
/tree-sitter-jairs/src/tree_sitter/
/tree-sitter-jairs/build/
/tree-sitter-jairs/node_modules/
/tree-sitter-jairs/*.wasm

.DS_Store
